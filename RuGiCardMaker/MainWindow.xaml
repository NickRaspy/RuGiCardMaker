<Window x:Class="RuGiCardMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RuGiCardMaker" Width="820" Height="560"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Image Source="Assets/blue-eyes-white-dragon.jpg" Stretch="Uniform"/>
            <Image x:Name="CardArtwork" Stretch="Uniform" Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Column="1" Background="#B8B8B8"/>

        <ScrollViewer Grid.Column="2" Margin="16,0,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Название карты" Margin="0,0,0,4"/>
                <TextBox x:Name="CardNameInput" Text="Голубоглазый белый дракон"
                         Height="25" MaxLength="80"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Тип карты" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CardTypeInput" Height="25" SelectedIndex="0">
                            <ComboBoxItem Content="Монстр"/>
                            <ComboBoxItem Content="Магия"/>
                            <ComboBoxItem Content="Ловушка"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Подтип" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CardSubtypeInput" Height="25" SelectedIndex="0">
                            <ComboBoxItem Content="Обычный"/>
                            <ComboBoxItem Content="Эффект"/>
                            <ComboBoxItem Content="Ритуал"/>
                            <ComboBoxItem Content="Слияние"/>
                            <ComboBoxItem Content="Синхро"/>
                            <ComboBoxItem Content="Иксиз"/>
                            <ComboBoxItem Content="Ссылка"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Атрибут" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AttributeInput" Height="25" SelectedIndex="0">
                            <ComboBoxItem Content="Свет"/>
                            <ComboBoxItem Content="Тьма"/>
                            <ComboBoxItem Content="Огонь"/>
                            <ComboBoxItem Content="Вода"/>
                            <ComboBoxItem Content="Земля"/>
                            <ComboBoxItem Content="Ветер"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Уровень" Margin="0,0,0,4"/>
                        <ComboBox x:Name="LevelInput" Height="25" SelectedIndex="7">
                            <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/><ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/><ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/><ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/><ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="11"/><ComboBoxItem Content="12"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Атака (ATK)" Margin="0,0,0,4"/>
                        <TextBox x:Name="AttackInput" Height="25" Text="3000" MaxLength="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Защита (DEF)" Margin="0,0,0,4"/>
                        <TextBox x:Name="DefenseInput" Height="25" Text="2500" MaxLength="6"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Редкость" Margin="0,14,0,4"/>
                <ComboBox x:Name="RarityInput" Height="25" SelectedIndex="0">
                    <ComboBoxItem Content="Обычная"/>
                    <ComboBoxItem Content="Редкая"/>
                    <ComboBoxItem Content="Суперредкая"/>
                    <ComboBoxItem Content="Ультраредкая"/>
                </ComboBox>

                <TextBlock Text="Текст карты" Margin="0,14,0,4"/>
                <TextBox x:Name="EffectInput" Height="82"
                         Text="Легендарный дракон, чьи крылья сияют в ночном небе."
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Образец карты" Margin="0,14,0,4"/>
                <DockPanel LastChildFill="True">
                    <Button Content="Заменить..." Padding="10,3"
                            DockPanel.Dock="Left" Click="ChooseArtwork_Click"/>
                    <TextBlock x:Name="ArtworkFileLabel" Text="Образец карты"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <Button Content="Сбросить" HorizontalAlignment="Right"
                        Padding="12,3" Margin="0,18,0,4"
                        Click="ResetFields_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
